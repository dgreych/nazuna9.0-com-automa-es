{
  "name": "nazuna-bot-gyomei",
  "version": "1.0.0",
  "description": "NAZUNA BOT - versão modificada GYOMEI, baseada na Nazuna 9.0 com novos comandos, automações, IA e deploy controlado",
  "type": "module",
  "main": "dados/src/connect.js",
  "scripts": {
    "start": "node dados/src/.scripts/start-v9.js",
    "start:validated": "npm run validate:local && npm start",
    "dev": "nodemon dados/src/.scripts/start-v9.js",
    "validate:ci": "node dados/src/.scripts/validate-local.js --ci && node dados/src/.scripts/validate-release-output.js",
    "validate:local": "node dados/src/.scripts/validate-local.js --local && node dados/src/.scripts/validate-release-output.js",
    "validate:deploy": "node dados/src/.scripts/validate-local.js --deploy && node dados/src/.scripts/validate-release-output.js",
    "validate:public": "npm run validate:ci && node dados/src/.scripts/audit-public.js",
    "build:server": "node dados/src/.scripts/build-server.js --private && node dados/src/.scripts/sanitize-server-build.js --private",
    "build:server:artifact": "node dados/src/.scripts/build-server.js --public && node dados/src/.scripts/sanitize-server-build.js --public",
    "config": "node dados/src/.scripts/config.js",
    "config:install": "node dados/src/.scripts/config.js --install",
    "update": "node dados/src/.scripts/update.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgreych/nazuna9.0-com-automa-es.git"
  },
  "homepage": "https://github.com/dgreych/nazuna9.0-com-automa-es",
  "author": "Hiudy (criação original), DevTokyo (continuidade da Nazuna) e Alaska_dev (aprimoramentos da versão modificada GYOMEI)",
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "axios": "^1.13.2",
    "baileys": "npm:baileys-mod",
    "cheerio": "^1.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^0.16.13",
    "linkedom": "^0.18.12",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "node-webpmux": "^3.2.1",
    "pino": "^10.1.0",
    "qrcode-terminal": "^0.12.0",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
